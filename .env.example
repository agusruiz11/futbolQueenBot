# ─── Obligatorio ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
# Dominio del sitio del cliente. En producción poné el dominio real, no *.
ALLOWED_ORIGIN=*

# ─── Modelo ──────────────────────────────────────────────────────────────────
# claude-opus-5 es el default. claude-sonnet-5 sale más barato si el volumen sube.
BOT_MODEL=claude-opus-5
# low | medium | high — medium equilibra precisión en la tabla de precios y latencia
BOT_EFFORT=medium
BOT_TZ=America/Argentina/Buenos_Aires
# Reintento automático en otro modelo si los clasificadores rechazan un pedido.
# Si al arrancar la API devuelve 400 mencionando "server-side-fallback", ponelo en false.
BOT_FALLBACKS=true
# Máximo de globos de chat por respuesta
MAX_GLOBOS=3

# Franja en la que están atendiendo el WhatsApp al que deriva el bot. Fuera de
# ella deriva igual, pero avisa que le responden al otro día.
WSP_HORA_DESDE=9
WSP_HORA_HASTA=22

# Número al que deriva el bot, en formato internacional sin + ni espacios.
WSP_TELEFONO=5491123947419

# Dominio público del server. Con esto definido el bot manda un link corto
# (tudominio.com/w/xxxxxxx) en vez de la URL de WhatsApp con el resumen
# encodeado, que en Instagram se ve como un muro de %20. Sin definir, sigue
# mandando el link largo.
PUBLIC_BASE_URL=https://futbolqueenbot-production.up.railway.app/
# Dónde persistir los resúmenes de los links cortos. En Railway el filesystem es
# efímero: si se pierden, el link sigue abriendo el WhatsApp con el texto por
# defecto. Montá un volumen acá si querés que sobrevivan a los redeploys.
WSP_LINKS_FILE=./data/wsp-links.json

# ─── Instagram ───────────────────────────────────────────────────────────────
IG_ENABLED=true
IG_VERIFY_TOKEN=un-string-que-elijas-vos
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# Con "Instagram API con Instagram Login" (tokens que empiezan con IGAA) va
# graph.instagram.com. Solo si la app usa Facebook Login (tokens EAA) va
# graph.facebook.com — mezclarlos da "Cannot parse access token".
IG_GRAPH_BASE=https://graph.instagram.com/v21.0
IG_TZ=America/Argentina/Buenos_Aires

# Ventana horaria del bot en Instagram. Si las dejás sin definir, contesta
# siempre. Si querés que el bot cubra solo la noche y una persona atienda de día,
# poné por ejemplo START=20 y END=9.
# IG_BOT_START_HOUR=20
# IG_BOT_END_HOUR=9

# Ritmo de envío (Meta penaliza las ráfagas de mensajes automáticos)
IG_MSG_DELAY_MS=2500
IG_MSG_JITTER_MS=900
IG_TYPING=true
