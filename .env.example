# ─── Obligatorio ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
# Dominio del sitio del cliente. En producción poné el dominio real, no *.
ALLOWED_ORIGIN=*

# ─── Modelo ──────────────────────────────────────────────────────────────────
# claude-sonnet-5 es el default: para responder sobre la tabla de precios rinde
# igual que opus y sale bastante menos (opus cuesta ~2,5x por token).
BOT_MODEL=claude-sonnet-5
# low | medium | high — el effort regula cuánto piensa el modelo antes de contestar,
# y esos tokens se facturan como salida. low alcanza para este bot.
BOT_EFFORT=low
BOT_TZ=America/Argentina/Buenos_Aires
# Reintento automático en otro modelo si los clasificadores rechazan un pedido.
# No todos los modelos lo soportan. Si el configurado no lo acepta, el bot lo
# detecta solo en la primera llamada y sigue sin fallbacks — pero te ahorrás esa
# llamada perdida poniéndolo en false. claude-sonnet-5 NO lo soporta.
BOT_FALLBACKS=false
# Máximo de globos de chat por respuesta
MAX_GLOBOS=3
# Modelo para el triage del primer mensaje de Instagram (familia / vendedor /
# busca trabajo / adulta / otro). Es una llamada de ~600 tokens y una palabra de
# salida, así que un modelo chico alcanza y sale casi gratis. Sin definir usa
# BOT_MODEL. Si el modelo no existe, el triage falla y trata a todos como familia.
# TRIAGE_MODEL=claude-haiku-4-5

# Franja en la que están atendiendo el WhatsApp al que deriva el bot. Fuera de
# ella deriva igual, pero avisa que le responden al otro día.
WSP_HORA_DESDE=9
WSP_HORA_HASTA=22

# Número al que deriva el bot, en formato internacional sin + ni espacios.
WSP_TELEFONO=5491123947419

# Dominio público del server. Con esto definido el bot manda un link corto
# (tudominio.com/w/xxxxxxx) en vez de la URL de WhatsApp con el resumen
# encodeado, que en Instagram se ve como un muro de %20. Sin definir, sigue
# mandando el link largo.
PUBLIC_BASE_URL=https://futbolqueenbot-production.up.railway.app/
# Dónde persistir los resúmenes de los links cortos. En Railway el filesystem es
# efímero: si se pierden, el link sigue abriendo el WhatsApp con el texto por
# defecto. Montá un volumen acá si querés que sobrevivan a los redeploys.
WSP_LINKS_FILE=./data/wsp-links.json

# ─── Instagram ───────────────────────────────────────────────────────────────
IG_ENABLED=true
IG_VERIFY_TOKEN=un-string-que-elijas-vos
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# Con "Instagram API con Instagram Login" (tokens que empiezan con IGAA) va
# graph.instagram.com. Solo si la app usa Facebook Login (tokens EAA) va
# graph.facebook.com — mezclarlos da "Cannot parse access token".
IG_GRAPH_BASE=https://graph.instagram.com/v21.0
IG_TZ=America/Argentina/Buenos_Aires

# Cuántas horas de inactividad antes de dar la charla por terminada y arrancar
# de cero. La gente pregunta, lo charla en casa y contesta al otro día: con 6 hs
# esa respuesta caía en una sesión nueva y el bot volvía a saludar y a preguntar
# todo otra vez. Ojo que la memoria vive en RAM, así que un redeploy la borra
# igual por más que el TTL diga 48.
IG_SESSION_TTL_HS=48

# Ventana horaria del bot en Instagram. Si las dejás sin definir, contesta
# siempre. Si querés que el bot cubra solo la noche y una persona atienda de día,
# poné por ejemplo START=20 y END=9.
# IG_BOT_START_HOUR=20
# IG_BOT_END_HOUR=9

# Agrupado de mensajes. La gente manda la idea partida en varios mensajes ("16" /
# "Años", o dos frases con segundos de diferencia) y sin esto el bot contesta una
# vez por cada uno, repitiendo lo mismo. Cada mensaje nuevo reinicia la espera:
# el bot contesta cuando pasan IG_DEBOUNCE_MS sin que escriba nada más. Más alto
# agrupa mejor pero tarda más en contestar; 20 s se siente como alguien que lee y
# escribe. Con 0 contesta enseguida (igual nunca corre dos respuestas a la vez
# para la misma persona).
IG_DEBOUNCE_MS=20000
# Tope de espera contado desde el primer mensaje sin responder: si la persona
# sigue escribiendo cada pocos segundos, a lo sumo espera esto antes de contestar
# con todo lo que haya.
IG_DEBOUNCE_MAX_MS=60000

# Ritmo de envío (Meta penaliza las ráfagas de mensajes automáticos)
IG_MSG_DELAY_MS=2500
IG_MSG_JITTER_MS=900
IG_TYPING=true

# Textos de las automatizaciones de Meta (ej.: el DM que se manda a quien comenta
# "info" en un posteo). Esos DMs salen como echo de la cuenta y el bot los tomaba
# como una respuesta del equipo: pausaba la charla 2 hs. Si el echo contiene alguno
# de estos fragmentos, no pausa. Separados por "|"; se comparan sin mayúsculas,
# sin tildes y con los espacios colapsados. Sin definir usa el valor de abajo.
AUTO_DM_TEXTOS=escuela de futbol para ninas y adolescentes

# ─── Token de Instagram: refresco y avisos ───────────────────────────────────
# El token de Instagram Login dura 60 días. El bot lo refresca solo (al arrancar
# y una vez por día revisa; refresca si pasaron 7 días) y guarda acá lo que
# devuelve Meta. En Railway el filesystem es efímero: sin un volumen montado en
# esta carpeta el archivo se pierde en cada deploy y el bot vuelve a arrancar con
# IG_ACCESS_TOKEN.
IG_TOKEN_FILE=./data/ig-token.json
# El refresco corre solo en Railway (cuando existe RAILWAY_ENVIRONMENT), así
# levantar el bot en tu máquina no toca el token de producción. Con true o false
# lo forzás; false es el interruptor para apagarlo sin tocar código.
# IG_TOKEN_REFRESH=true
# Con cuántos días de margen avisa que el token está por vencer.
IG_TOKEN_AVISO_DIAS=10
# Incoming webhook de Slack para los avisos (token vencido o por vencer, refresco
# que falla). Sin definir, los avisos quedan solo en el log con la marca [alerta].
# Que apunte a un canal interno, nunca al canal compartido con el cliente.
SLACK_WEBHOOK_URL=
